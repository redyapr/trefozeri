<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trefozeri.signal</string>

    <!-- cd into the project so python-dotenv finds .env -->
    <key>WorkingDirectory</key>
    <string>/Users/redyapr/Documents/projects/trefozeri/AI</string>

    <!-- run the venv's python on the engine, live + Telegram alert -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/redyapr/Documents/projects/trefozeri/AI/venv/bin/python</string>
        <string>/Users/redyapr/Documents/projects/trefozeri/AI/trefozeri.py</string>
        <string>--live</string>
        <string>--telegram</string>
    </array>

    <!-- fire every minute (entry_tf is now M1) — an empty dict = wildcard on every field,
         so this matches every minute of every hour of every day. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict/>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/redyapr/Documents/projects/trefozeri/AI/run.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/redyapr/Documents/projects/trefozeri/AI/run.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
