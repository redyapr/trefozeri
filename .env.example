TWELVE_DATA_API_KEY=

# Optional: Telegram notifications for new/closed signals (XAUUSD only for now — see
# TELEGRAM_SYMBOLS in scripts/fetch-data.mjs). Leave both unset to skip notifications
# entirely (e.g. local dev) — sendTelegramMessage() no-ops without them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: same bot, but a private DM chat id for ops alerts (a data source failing
# even after retries + fallback, or a fatal script error) — kept separate from
# TELEGRAM_CHAT_ID so run-health noise never lands in the public signals channel.
TELEGRAM_PERSONAL_CHAT_ID=

# Optional: only needed on a fork/rename/domain change — the fallback fetch (see
# fetchWithFallback in scripts/fetch-data.mjs) defaults to this repo's own deployment
# when unset.
SITE_URL=

# Optional: how many hours must pass before the exact same admin-alert text (see
# TELEGRAM_PERSONAL_CHAT_ID above) is allowed to send again. Defaults to 6.
ALERT_SUPPRESS_HOURS=
